[Unit]
Description=SO101 AprilTag stream to ESP32 (detect_atags.py)
Documentation=file://@REPO_DIR@/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/run_detect_atags.sh
Restart=on-failure
RestartSec=5
# Override in a drop-in if needed: Environment=SERIAL_PORT=/dev/ttyUSB0

[Install]
WantedBy=default.target
