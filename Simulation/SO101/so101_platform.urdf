<?xml version="1.0"?>
<!-- SO-101 differential-drive mobile base (STS3215 1/345 front wheels).
     Converted from so101_platform.xml (MuJoCo).
     Axes: +X forward, +Y left, +Z up (matches so101_new_calib / Panda sim).
     Wheel layout:
      distance from center to front wheels (+X): 5.75 in
      distance from wheel to wheel: 9.5 in
      distance from center to back wheels (-X): 5.75 in
      wheel diameter: 4 in
      wheel width: 1 in
     Front left/right wheels: continuous joints (encoder angle maps to 12-bit raw).
     Rear wheels: passive omni casters (MuJoCo ball joints; URDF uses continuous spin). -->
<robot name="so101_platform">

  <!-- Ground / odometry frame. Platform body origin sits at wheel-axle height. -->
  <link name="base_footprint"/>

  <link name="platform">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.02" iyy="0.03" izz="0.04" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="chassis_visual">
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry>
        <mesh filename="assets/ChassisV2.stl"/>
      </geometry>
      <material name="chassis_gray">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
    <collision name="chassis_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3048 0.254 0.0508"/>
      </geometry>
    </collision>
  </link>

  <!-- MuJoCo freejoint → URDF floating base (6-DOF). -->
  <joint name="platform_free" type="floating">
    <parent link="base_footprint"/>
    <child link="platform"/>
    <origin xyz="0 0 0.0508" rpy="0 0 0"/>
  </joint>

  <!-- Mount frame for SO101 arm (matches arm_mount site in MJCF). -->
  <link name="arm_mount"/>

  <joint name="arm_mount_joint" type="fixed">
    <parent link="platform"/>
    <child link="arm_mount"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wheel_fl">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0002" iyy="0.0003" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="wheel_fl_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="assets/FrontWheel.stl"/>
      </geometry>
      <material name="wheel_dark">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision name="wheel_fl_collision">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.0508" length="0.0254"/>
      </geometry>
    </collision>
  </link>

  <!-- STS servo ID 7 on hardware. -->
  <joint name="wheel_left" type="continuous">
    <parent link="platform"/>
    <child link="wheel_fl"/>
    <origin xyz="0.14605 0.12065 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.60" friction="0.052"/>
  </joint>

  <link name="wheel_fr">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.0002" iyy="0.0003" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="wheel_fr_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="assets/FrontWheel.stl"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision name="wheel_fr_collision">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.0508" length="0.0254"/>
      </geometry>
    </collision>
  </link>

  <!-- STS servo ID 8 on hardware. -->
  <joint name="wheel_right" type="continuous">
    <parent link="platform"/>
    <child link="wheel_fr"/>
    <origin xyz="0.14605 -0.12065 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.60" friction="0.052"/>
  </joint>

  <link name="wheel_rl">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.00015" iyy="0.0002" izz="0.00015" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="wheel_rl_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="assets/Omniwheel.stl"/>
      </geometry>
      <material name="omni_gray">
        <color rgba="0.35 0.35 0.35 1"/>
      </material>
    </visual>
    <collision name="wheel_rl_collision">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.0508" length="0.0254"/>
      </geometry>
    </collision>
  </link>

  <!-- Passive omni caster (MJCF ball joint; URDF models wheel spin only). -->
  <joint name="omni_left" type="continuous">
    <parent link="platform"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.14605 0.12065 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

  <link name="wheel_rr">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.00015" iyy="0.0002" izz="0.00015" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual name="wheel_rr_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="assets/Omniwheel.stl"/>
      </geometry>
      <material name="omni_gray"/>
    </visual>
    <collision name="wheel_rr_collision">
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.0508" length="0.0254"/>
      </geometry>
    </collision>
  </link>

  <joint name="omni_right" type="continuous">
    <parent link="platform"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.14605 -0.12065 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.001"/>
  </joint>

</robot>
