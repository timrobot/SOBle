  <contact>
    <!--
      L1 and L2 may pass through the rear wheel only. They collide with the
      front wheel. L2 also collides with the chassis. L1 is a child of the
      chassis body, so MuJoCo does not generate that parent-child pair.
      The foot passes through both wheels so the sole can sit under the body.
    -->
    <exclude body1="rear_left_wheel" body2="L1"/>
    <exclude body1="rear_right_wheel" body2="L1"/>
    <exclude body1="rear_left_wheel" body2="L2"/>
    <exclude body1="rear_right_wheel" body2="L2"/>
    <exclude body1="front_left_wheel" body2="foot"/>
    <exclude body1="front_right_wheel" body2="foot"/>
    <exclude body1="rear_left_wheel" body2="foot"/>
    <exclude body1="rear_right_wheel" body2="foot"/>
    <!-- The foot tucks against the thigh and under the chassis. -->
    <exclude body1="L1" body2="foot"/>
    <exclude body1="robot" body2="foot"/>
  </contact>

  <!--
    Each half of an axle has its own velocity actuator. Both halves are
    commanded at the same speed. Positive command rolls that wheel toward the stairs.
    Control is wheel speed in rad/s, limited to ±75 rpm. Torque is limited to ±5 Nm.
    J1 and J2 are position servos limited to ±40 Nm and 15 rpm. J3 is limited to
    ±40 Nm and 20 rpm. The gain is high because the hardware PID holds the
    commanded angle. J3 is set from the
    current J1 and J2 so the foot stays parallel to the body.
  -->
  <actuator>
    <velocity name="front_left_wheel" joint="front_left_axle" kv="1" ctrlrange="-7.85398163 7.85398163" forcerange="-5 5"/>
    <velocity name="front_right_wheel" joint="front_right_axle" kv="1" ctrlrange="-7.85398163 7.85398163" forcerange="-5 5"/>
    <velocity name="rear_left_wheel" joint="rear_left_axle" kv="1" ctrlrange="-7.85398163 7.85398163" forcerange="-5 5"/>
    <velocity name="rear_right_wheel" joint="rear_right_axle" kv="1" ctrlrange="-7.85398163 7.85398163" forcerange="-5 5"/>
    <position name="J1" joint="J1" kp="2000" dampratio="1" ctrlrange="-1.5707963 1.5707963" forcerange="-40 40"/>
    <position name="J2" joint="J2" kp="2000" dampratio="1" ctrlrange="0 2.8797933" forcerange="-40 40"/>
    <position name="J3" joint="J3" kp="2000" dampratio="1" ctrlrange="0 2.7052603" forcerange="-40 40"/>
  </actuator>

  <!-- Home: J1=-45°, J2=165°, J3=30°. -->
  <keyframe>
