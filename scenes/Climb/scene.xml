    <geom name="step_8" type="box" material="stair" pos="1.905 0 0.8123" size="0.127 0.6096 0.8123"/>
    <geom name="step_8_pad" type="box" material="pad" pos="1.905 0 1.6251" size="0.0635 0.6096 0.0005"/>
    <site name="step_8_pad" type="box" group="3" pos="1.905 0 1.6251" size="0.0635 0.6096 0.0005"/>

    <geom name="step_9" type="box" material="stair" pos="2.159 0 0.9139" size="0.127 0.6096 0.9139"/>
    <geom name="step_9_pad" type="box" material="pad" pos="2.159 0 1.8283" size="0.0635 0.6096 0.0005"/>
    <site name="step_9_pad" type="box" group="3" pos="2.159 0 1.8283" size="0.0635 0.6096 0.0005"/>

    <!--
      Landing floor, top flush with step 9 and starting exactly at x = 9*tread.
      The goal pad is centered 20 in past the step 9 pad, and it is the top
      slice of the landing there so the walking surface stays flush.
    -->
    <geom name="landing_before" type="box" material="landing" pos="2.413 0 0.9144" size="0.127 0.6096 0.9144"/>
    <geom name="landing_under_goal" type="box" material="landing" pos="2.667 0 0.90805" size="0.127 0.6096 0.90805"/>
    <geom name="goal_pad" type="box" material="goal" pos="2.667 0 1.82245" size="0.127 0.6096 0.00635"/>
    <site name="goal_pad" type="box" group="3" pos="2.667 0 1.82245" size="0.127 0.6096 0.00635"/>
    <geom name="landing_after" type="box" material="landing" pos="4.064 0 0.9144" size="1.27 0.6096 0.9144"/>

    <!--
      Chassis origin is midway between the axles, at wheel-center height.
      Front axle at local x = +3.25 in, rear axle at local x = -3.25 in.
      The front surface (one wheel radius ahead of the front axle)
      sits 4 in before the first riser.
