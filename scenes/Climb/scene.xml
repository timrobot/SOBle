<mujoco model="stair_climber">
  <!--
    Lengths in this file are meters. Inch sizes from the spec:
      1 inch            = 0.0254 m
      stair rise        = 8 in   = 0.2032 m
      stair tread       = 10 in  = 0.254 m
      stair width       = 48 in  = 1.2192 m   (not specified; wide enough for the wheel track)
      landing length    = 120 in = 3.048 m    (continues past the 9th tread)
      wheel radius      = 2 in   = 0.0508 m
      wheel half length = 3 in   = 0.0762 m   (cylindrical length of each left/right capsule)
      wheel track       = 11 in  = 0.2794 m   (left/right capsule centers, symmetric)
      wheel separation  = 6.5 in = 0.1651 m   (front/rear axle centers, along x)
      chassis radius    = 0.25 in = 0.00635 m
      leg L1            = 7.5 in = 0.1905 m   (box, 2.263780 in wide, 55 mm tall)
      leg L2            = 8.5 in = 0.2159 m   (box, 4.232283 in wide, 39.5 mm tall)
      foot length       = 8.25 in = 0.20955 m
      foot width        = 2.263780 in = 0.0575 m
      foot height       = 55 mm  = 0.055 m
      joint motor       = 55 mm diameter, 3.170138 in long, 800 g
      front clearance   = 4 in   = 0.1016 m   (gap from the front of the front wheel to the first riser)
      sensor pad        = 1 mm thick, 5 in deep (center half of the 10 in tread)

    Stairs run in +x. The first riser is the plane x = 0. Each tread is a solid box
    from the ground up to that step's height, so the side profile is a staircase.
    The center 5 in of the top 1 mm of every tread is a separate collision pad. A touch sensor on a
    matching site reports the normal contact force on that pad, in newtons.
    The 9th tread top is at z = 1.8288 m and ends at x = 2.286 m. The landing is a
    box, not a MuJoCo plane: plane geoms are infinite half-spaces, so a plane at
    landing height would solid-fill everything below it and bury the stairs.
  -->
  <compiler angle="degree" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0.15 0.15 0.15"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <default>
    <geom contype="1" conaffinity="1" condim="3" friction="1 0.005 0.0001" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    <joint damping="0.02" armature="0.01"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.05 0.08 0.12" width="512" height="3072"/>
    <texture name="groundplane" type="2d" builtin="checker" mark="edge" rgb1="0.85 0.85 0.85" rgb2="0.65 0.65 0.65" markrgb="0.9 0.9 0.9" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="8 8" reflectance="0.05"/>
    <material name="stair" rgba="0.55 0.52 0.48 1" reflectance="0.05"/>
    <material name="landing" rgba="0.55 0.52 0.48 1" reflectance="0.05"/>
    <material name="pad" rgba="0.15 0.65 0.35 1" reflectance="0.1"/>
    <material name="goal" rgba="0.85 0.2 0.15 1" reflectance="0.1"/>
    <material name="chassis" rgba="0.2 0.35 0.75 1"/>
    <material name="wheel" rgba="0.12 0.12 0.12 1"/>
    <material name="leg" rgba="0.72 0.42 0.18 1"/>
    <material name="foot" rgba="0.08 0.08 0.08 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true"/>
    <camera name="side" pos="-0.4 -3.2 1.4" xyaxes="1 0 0 0 0.35 0.94"/>

    <geom name="ground" type="plane" size="6 4 0.1" material="groundplane"/>

    <!--
      Nine stairs. Step i spans x = [(i-1)*tread, i*tread], top at z = i*rise.
      The structural box stops 1 mm short of that top. The pad is the center
      5 in of that 1 mm slice, across the full stair width. Sites are invisible
      (group 3); the green pad is the visual.
    -->
    <geom name="step_1" type="box" material="stair" pos="0.127 0 0.1011" size="0.127 0.6096 0.1011"/>
    <geom name="step_1_pad" type="box" material="pad" pos="0.127 0 0.2027" size="0.0635 0.6096 0.0005"/>
    <site name="step_1_pad" type="box" group="3" pos="0.127 0 0.2027" size="0.0635 0.6096 0.0005"/>

    <geom name="step_2" type="box" material="stair" pos="0.381 0 0.2027" size="0.127 0.6096 0.2027"/>
